<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- NuGet packages: every library under src/ is published -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <VersionPrefix>0.4.0</VersionPrefix>
    <Authors>TheoCvg</Authors>
    <Copyright>Copyright (c) 2026 TheoCvg</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TheoCvg/EasyBI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheoCvg/EasyBI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bi;business-intelligence;self-service;analytics;dashboard;charts;wpf</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- XML docs ship with the packages; undocumented members are allowed (see AGENTS.md) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
