<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- NuGet packages: every library under src/ is published -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <VersionPrefix>0.6.0</VersionPrefix>
    <Authors>TheoCvg</Authors>
    <Copyright>Copyright (c) 2026 TheoCvg</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://theocvg.github.io/EasyBI/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheoCvg/EasyBI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bi;business-intelligence;self-service;analytics;dashboard;charts;wpf</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- XML docs ship with the packages; undocumented members are allowed (see AGENTS.md) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Older targets (.NET Standard 2.0, .NET Framework): the libraries are written in modern C#, PolySharp generates at
    build time the attributes the compiler needs (records, init, required, nullable, ranges). It adds no runtime
    dependency. See docs/contributing.md, "Target frameworks".
  -->
  <PropertyGroup>
    <IsLegacyTarget Condition="'$(TargetFramework)' == 'netstandard2.0' Or $(TargetFramework.StartsWith('net4'))">true</IsLegacyTarget>
  </PropertyGroup>

  <!--
    The framework of older targets has no nullable annotations (string.IsNullOrEmpty...): their nullable warnings would
    be false positives. The .NET 8 build checks nullability; older targets keep the annotations, without warnings.
  -->
  <PropertyGroup Condition="'$(IsLegacyTarget)' == 'true'">
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsLegacyTarget)' == 'true'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Legacy/*.cs" Link="Shared/Legacy/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
