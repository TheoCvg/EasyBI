<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasyBI.Wpf\EasyBI.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Description>Material Design in XAML theme for EasyBI.Wpf: EasyBI's colors follow the Material Design theme, light or dark, and its controls take Material Design's styles.</Description>
    <PackageTags>$(PackageTags);materialdesign;material;theme</PackageTags>
  </PropertyGroup>

</Project>
