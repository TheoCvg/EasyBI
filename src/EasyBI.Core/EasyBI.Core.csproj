<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasyBI.Abstractions\EasyBI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests run the time calculations on a given day -->
    <InternalsVisibleTo Include="EasyBI.Core.Tests" />
  </ItemGroup>

  <!--
    .NET Standard 2.0 lacks these APIs: Microsoft's own packages bring them (in the box on .NET 8), and
    Portable.System.DateTimeOnly brings DateOnly, kept in the public API (see docs/contributing.md, "Target frameworks")
  -->
  <ItemGroup Condition="'$(IsLegacyTarget)' == 'true'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Portable.System.DateTimeOnly" Version="9.0.2" />
    <!-- Libraries built against its latest version (System.Text.Json, LiveCharts2): one version for the application -->
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Description>EasyBI query engine: semantic models over IQueryable (EF Core, LINQ to objects), expression-tree query translation, pivot, cross-filtering and JSON reports.</Description>
  </PropertyGroup>

</Project>
