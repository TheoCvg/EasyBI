<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasyBI.Wpf\EasyBI.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>WPF UI (lepoco) theme for EasyBI.Wpf: EasyBI's colors follow the WPF UI theme, light or dark, and its controls take WPF UI's styles.</Description>
    <PackageTags>$(PackageTags);wpfui;fluent;theme</PackageTags>
  </PropertyGroup>

</Project>
