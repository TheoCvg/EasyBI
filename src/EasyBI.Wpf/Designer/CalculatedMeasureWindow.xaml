<Window x:Class="EasyBI.Wpf.Designer.CalculatedMeasureWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bi="clr-namespace:EasyBI.Wpf"
        xmlns:d="clr-namespace:EasyBI.Wpf.Designer"
        Title="{bi:Localize CalculatedMeasureTitle}" Width="940" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}">
    <Window.Resources>
        <!-- The help of an item (function, field, operator, value): title, description, example. Plain content, so that
             the tooltips keep the application's style -->
        <DataTemplate x:Key="ItemHelp" DataType="{x:Type d:FormulaItem}">
            <StackPanel MaxWidth="360">
                <TextBlock Text="{Binding Title}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Description" Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="Example" Text="{Binding Example}" Margin="0,6,0,0" FontFamily="Consolas" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                    <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Example}" Value="{x:Null}">
                    <Setter TargetName="Example" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An item of the catalog and of the suggestions: its glyph, colored by kind, and its caption -->
        <DataTemplate x:Key="ItemRow" DataType="{x:Type d:FormulaItem}">
            <DockPanel Background="Transparent">
                <DockPanel.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource ItemHelp}" Placement="Left" />
                </DockPanel.ToolTip>
                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Width="24" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static bi:EasyBITheme.FormulaFunctionBrushKey}}" />
                <TextBlock Text="{Binding Caption}" Padding="0,3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Measure">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MeasureBrushKey}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Dimension">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.FormulaDimensionBrushKey}}" />
                    <Setter TargetName="Glyph" Property="FontSize" Value="10" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
        </Style>

        <!-- A hint over an empty text box -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer: restore (a measure of the model redefined in the report), OK, Cancel -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="{bi:Localize ResetMeasure}" Padding="12,4" Click="OnReset"
                        ToolTip="{bi:Localize RestoreMeasureTooltip}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{bi:Localize Ok}" IsDefault="True" MinWidth="90" Padding="12,4" Click="OnOk" IsEnabled="{Binding CanSave}" />
                    <Button Content="{bi:Localize Cancel}" IsCancel="True" MinWidth="90" Padding="12,4" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Header: name and format -->
        <Grid DockPanel.Dock="Top" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{bi:Localize MeasureCaption}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
            <TextBox x:Name="CaptionBox" Grid.Column="1" Padding="6,4" FontSize="14" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="{bi:Localize MeasureFormat}" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="SemiBold" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding Format}" DisplayMemberPath="Label" VerticalContentAlignment="Center" />
        </Grid>

        <!-- A measure of the model: what redefining it means -->
        <Border x:Name="RedefinitionBanner" DockPanel.Dock="Top" Margin="20,0,20,12" Padding="12,8" BorderThickness="1"
                CornerRadius="{DynamicResource {x:Static bi:EasyBITheme.CornerRadiusKey}}"
                Background="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBrushKey}}"
                BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBorderBrushKey}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="ⓘ" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                <TextBlock x:Name="RedefinitionHint" TextWrapping="Wrap" FontSize="12" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: the formula, the operators, the function at the caret, the status -->
            <Grid Margin="20,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="90" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{bi:Localize MeasureFormula}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="18" Height="18" CornerRadius="9" Margin="6,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderStrongBrushKey}}">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{bi:Localize MeasureFormulaHint}" TextWrapping="Wrap" MaxWidth="380" />
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="?" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    </Border>
                    <TextBlock Text="{bi:Localize FormulaShortcutsHint}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                               Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                </DockPanel>

                <!-- The formula: a plain text box, colored by a FormulaHighlighter added over it -->
                <Grid x:Name="FormulaHost" Grid.Row="1">
                    <TextBox x:Name="FormulaBox" Padding="8,8" AcceptsReturn="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="15"
                             Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{bi:Localize FormulaPlaceholder}" Margin="12,10,12,0" FontSize="13" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Formula}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=FormulaBox}" Placement="Relative" StaysOpen="True"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Margin="0,0,8,8" BorderThickness="1" Padding="2" MinWidth="260" MaxWidth="380"
                                CornerRadius="{DynamicResource {x:Static bi:EasyBITheme.CornerRadiusKey}}"
                                Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderStrongBrushKey}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource ItemRow}" MaxHeight="240"
                                     Focusable="False" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="OnSuggestionClicked" />
                        </Border>
                    </Popup>
                </Grid>

                <!-- Operators -->
                <ItemsControl Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Operators}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Caption}" MinWidth="34" Padding="8,2" Margin="0,0,4,4" FontSize="12" Focusable="False" Click="OnInsertClicked">
                                <Button.ToolTip>
                                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource ItemHelp}" />
                                </Button.ToolTip>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- How to write the function at the caret -->
                <Border Grid.Row="3" Margin="0,6,0,0" Padding="10,6" BorderThickness="1"
                        CornerRadius="{DynamicResource {x:Static bi:EasyBITheme.CornerRadiusKey}}"
                        Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentCall}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentCall.Function.Usage}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static bi:EasyBITheme.FormulaFunctionBrushKey}}" />
                        <TextBlock Text="{Binding CurrentCall.Function.Description}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    </StackPanel>
                </Border>

                <!-- Why the measure cannot be saved, or the total of a valid formula -->
                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusIcon" DockPanel.Dock="Left" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="Status" TextWrapping="Wrap" MinHeight="18" />
                </DockPanel>
            </Grid>

            <!-- Right: the catalog of functions and fields, and the details of the selected one -->
            <Border Grid.Column="1" BorderThickness="1,1,0,0"
                    Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,12,12,8">
                        <TextBox x:Name="SearchBox" Padding="6,4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchKeyDown" />
                        <TextBlock Text="{bi:Localize FormulaSearchPlaceholder}" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="CatalogList" Grid.Row="1" Margin="4,0,4,0" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}"
                             ItemTemplate="{StaticResource ItemRow}" SelectedItem="{Binding SelectedItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             MouseDoubleClick="OnCatalogDoubleClick" KeyDown="OnCatalogKeyDown">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="6,10,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <TextBlock x:Name="NoMatch" Grid.Row="1" Margin="16,8" Text="{bi:Localize FormulaNoMatch}" TextWrapping="Wrap" FontSize="12"
                               Visibility="Collapsed" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />

                    <!-- Details of the selected item; the values of a dimension -->
                    <Border x:Name="Details" Grid.Row="2" BorderThickness="0,1,0,0" Padding="12,10,12,12"
                            BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{bi:Localize FormulaInsert}" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                        Click="OnInsertSelected" />
                                <ContentPresenter Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ItemHelp}" />
                            </DockPanel>
                            <TextBlock x:Name="ValuesHeader" Text="{bi:Localize FormulaValuesHeader}" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                            <ScrollViewer x:Name="ValuesScroller" MaxHeight="96" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Values}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Caption}" Padding="6,1" Margin="0,0,4,4" FontSize="11" Focusable="False"
                                                    ToolTip="{Binding Text}" Click="OnInsertClicked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
