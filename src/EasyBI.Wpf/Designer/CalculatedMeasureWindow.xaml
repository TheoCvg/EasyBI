<Window x:Class="EasyBI.Wpf.Designer.CalculatedMeasureWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bi="clr-namespace:EasyBI.Wpf"
        Title="{bi:Localize CalculatedMeasureTitle}" Width="620" SizeToContent="Height" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="InsertField">
            <Button Content="{Binding}" Tag="{Binding}" Padding="8,2" Margin="0,4,6,0" FontSize="12" Click="OnInsert" />
        </DataTemplate>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{bi:Localize Ok}" IsDefault="True" MinWidth="90" Padding="12,4" Click="OnOk" IsEnabled="{Binding CanSave}" />
                <Button Content="{bi:Localize Cancel}" IsCancel="True" MinWidth="90" Padding="12,4" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{bi:Localize MeasureCaption}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="CaptionBox" Grid.Column="1" Padding="4,3" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Text="{bi:Localize MeasureFormat}" VerticalAlignment="Center" Margin="0,10,12,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="180"
                      ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding Format}" DisplayMemberPath="Label" />

            <TextBlock Grid.Row="2" Text="{bi:Localize MeasureFormula}" VerticalAlignment="Top" Margin="0,14,12,0" />
            <TextBox x:Name="FormulaBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Padding="4,3" MinHeight="64"
                     AcceptsReturn="False" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                     Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Insert buttons: the operators, the functions, then the model's measures and dimensions -->
            <ScrollViewer Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="+" Tag=" + " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="−" Tag=" - " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="×" Tag=" * " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="÷" Tag=" / " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="( )" Tag="()" Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="=" Tag=" = " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="≠" Tag=" &lt;&gt; " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="&lt;" Tag=" &lt; " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="&gt;" Tag=" &gt; " Padding="10,2" Margin="0,4,6,0" Click="OnInsert" />
                        <Button Content="AND" Tag=" AND " Padding="8,2" Margin="0,4,6,0" FontSize="12" Click="OnInsert" />
                        <Button Content="OR" Tag=" OR " Padding="8,2" Margin="0,4,6,0" FontSize="12" Click="OnInsert" />
                        <Button Content="NOT" Tag="NOT " Padding="8,2" Margin="0,4,6,0" FontSize="12" Click="OnInsert" />
                    </WrapPanel>

                    <TextBlock Text="{bi:Localize FormulaFunctionsHeader}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Functions}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding Name, StringFormat={}{0}()}" Padding="8,2" Margin="0,4,6,0"
                                        FontSize="12" FontFamily="Consolas" Click="OnInsert">
                                    <Button.ToolTip>
                                        <StackPanel MaxWidth="360">
                                            <TextBlock Text="{Binding Usage}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button.ToolTip>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{bi:Localize MeasuresHeader}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Insertable}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource InsertField}" />

                    <TextBlock Text="{bi:Localize DimensionsHeader}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding InsertableDimensions}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource InsertField}" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{bi:Localize MeasureFormulaHint}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />

            <!-- Why the measure cannot be saved, or the total of a valid formula -->
            <TextBlock x:Name="Status" Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="18" />
        </Grid>
    </DockPanel>
</Window>
