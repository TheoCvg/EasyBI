<Window x:Class="EasyBI.Wpf.Designer.VariableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bi="clr-namespace:EasyBI.Wpf"
        xmlns:d="clr-namespace:EasyBI.Wpf.Designer"
        Title="{bi:Localize VariableTitle}" Width="460" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{bi:Localize Ok}" IsDefault="True" MinWidth="90" Padding="12,4" Click="OnOk" IsEnabled="{Binding CanSave}" />
                <Button Content="{bi:Localize Cancel}" IsCancel="True" MinWidth="90" Padding="12,4" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource {x:Static bi:EasyBITheme.ErrorBrushKey}}" />
        </DockPanel>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{bi:Localize VariableKind}" Style="{StaticResource Label}" />
                <ComboBox x:Name="KindBox" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Label"
                          IsEnabled="{Binding IsNew}" />
                <TextBlock Grid.Row="1" Text="{bi:Localize VariableName}" Style="{StaticResource Label}" Margin="0,8,12,0" />
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="4,2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsNew, Converter={x:Static d:VariableWindow.Not}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Text="{Binding ReferenceHint}" Style="{StaticResource Hint}" />
                <TextBlock Grid.Row="3" Text="{bi:Localize VariableCaption}" Style="{StaticResource Label}" Margin="0,8,12,0" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Padding="4,2" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Separator Margin="0,12" />

            <!-- A parameter: its type, value, bounds (a slider on the dashboard), choices and format -->
            <Grid Visibility="{Binding IsParameter, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{bi:Localize VariableDataType}" Style="{StaticResource Label}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding ParameterType}" DisplayMemberPath="Label" />

                <TextBlock Grid.Row="1" Text="{bi:Localize VariableValue}" Style="{StaticResource Label}" Margin="0,8,12,0" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                    <TextBox Padding="4,2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasTextValue, Converter={StaticResource Visible}}" />
                    <DatePicker SelectedDate="{Binding DateValue}" Visibility="{Binding IsDate, Converter={StaticResource Visible}}" />
                    <CheckBox IsChecked="{Binding BooleanValue}" VerticalAlignment="Center" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" />
                </Grid>

                <TextBlock Grid.Row="2" Text="{bi:Localize VariableRange}" Style="{StaticResource Label}" Margin="0,8,12,0"
                           Visibility="{Binding IsNumber, Converter={StaticResource Visible}}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Visibility="{Binding IsNumber, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="70" Padding="4,2" Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{bi:Localize VariableMinimum}" />
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Width="70" Padding="4,2" Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{bi:Localize VariableMaximum}" />
                        <TextBlock Text="{bi:Localize VariableStep}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Width="50" Padding="4,2" Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Text="{bi:Localize VariableRangeHint}" Style="{StaticResource Hint}" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{bi:Localize VariableChoices}" Style="{StaticResource Label}" Margin="0,8,12,0" VerticalAlignment="Top"
                           Visibility="{Binding IsText, Converter={StaticResource Visible}}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Visibility="{Binding IsText, Converter={StaticResource Visible}}">
                    <TextBox Padding="4,2" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding Choices, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0" Text="{bi:Localize VariableChoicesHint}" Style="{StaticResource Hint}" />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="{bi:Localize VariableFormat}" Style="{StaticResource Label}" Margin="0,8,12,0"
                           Visibility="{Binding HasFormat, Converter={StaticResource Visible}}" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Padding="4,2" Width="100" HorizontalAlignment="Left"
                         Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" ToolTip="{bi:Localize VariableFormatHint}"
                         Visibility="{Binding HasFormat, Converter={StaticResource Visible}}" />
            </Grid>

            <!-- A set: the dimension, then the values by a measure or checked one by one -->
            <StackPanel Visibility="{Binding IsSet, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{bi:Localize VariableModel}" Style="{StaticResource Label}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" DisplayMemberPath="Label" />
                    <TextBlock Grid.Row="1" Text="{bi:Localize VariableField}" Style="{StaticResource Label}" Margin="0,8,12,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" DisplayMemberPath="Label" />
                </Grid>

                <RadioButton Margin="0,12,0,0" Content="{bi:Localize SetByMeasure}" IsChecked="{Binding IsRule}" GroupName="SetMode" />
                <WrapPanel Margin="20,6,0,0" IsEnabled="{Binding IsRule}">
                    <ComboBox MinWidth="90" ItemsSource="{Binding Orders}" SelectedItem="{Binding Order}" DisplayMemberPath="Label" Margin="0,0,6,4" />
                    <TextBox Width="48" Padding="4,2" Margin="0,0,6,4" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasFixedCount, Converter={StaticResource Visible}}" />
                    <ComboBox MinWidth="110" ItemsSource="{Binding CountVariables}" SelectedItem="{Binding CountVariable}" DisplayMemberPath="Label" Margin="0,0,6,4"
                              ToolTip="{bi:Localize SetCountHint}" />
                    <TextBlock Text="{bi:Localize SetBy}" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <ComboBox MinWidth="140" ItemsSource="{Binding Measures}" SelectedItem="{Binding Measure}" DisplayMemberPath="Label" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock Margin="20,2,0,0" Text="{bi:Localize SetByMeasureHint}" Style="{StaticResource Hint}" />

                <RadioButton Margin="0,12,0,0" Content="{bi:Localize SetFixed}" IsChecked="{Binding IsFixed}" GroupName="SetMode" />
                <d:FilterEditor Margin="20,6,0,0" DataContext="{Binding Members}" IsEnabled="{Binding DataContext.IsFixed, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
