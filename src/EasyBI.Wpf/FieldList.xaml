<UserControl x:Class="EasyBI.Wpf.FieldList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bi="clr-namespace:EasyBI.Wpf"
             xmlns:dnd="clr-namespace:EasyBI.Wpf.DragAndDrop"
             Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}">
    <UserControl.Resources>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{bi:Localize ModelHeader}" Style="{StaticResource SectionHeader}" />
        <ComboBox Grid.Row="1" x:Name="ModelPicker" SelectedValuePath="Value" DisplayMemberPath="Label" />
        <TextBlock Grid.Row="2" Text="{bi:Localize DimensionsHeader}" Style="{StaticResource SectionHeader}" />
        <!-- Fields are dragged as ModelField items. Local values rather than a style, so that the application's ListBox
             and ListBoxItem styles (a control library's) still apply, even when it changes them at runtime; the
             foreground is set because the system's ListBox style does not inherit it -->
        <ListBox Grid.Row="3" x:Name="DimensionList" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 dnd:DragSource.IsEnabled="True" dnd:DragSource.AllowedEffects="Copy">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◆" Foreground="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Caption}" Padding="0,3" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="4" Text="{bi:Localize MeasuresHeader}" Style="{StaticResource SectionHeader}" />
        <ListBox Grid.Row="5" x:Name="MeasureList" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 dnd:DragSource.IsEnabled="True" dnd:DragSource.AllowedEffects="Copy">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Calculated measures of the report (ƒx) can be edited and deleted from their buttons, shown on hover -->
                    <DockPanel>
                        <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="✎" ToolTip="{bi:Localize EditMeasure}" Click="OnEditMeasure" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                            <Button Content="✕" ToolTip="{bi:Localize DeleteMeasure}" Click="OnDeleteMeasure" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                        </StackPanel>
                        <TextBlock x:Name="Glyph" Text="Σ" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MeasureBrushKey}}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Caption}" Padding="0,3" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEditable}" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="ƒx" />
                            <Setter TargetName="Glyph" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEditable}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="6" x:Name="AddMeasureButton" Content="{bi:Localize NewCalculatedMeasure}" Click="OnAddMeasure"
                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3" FontSize="12" />
    </Grid>
</UserControl>
