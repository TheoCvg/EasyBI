<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:renderers="clr-namespace:EasyBI.Wpf.Renderers">

    <!-- A value of a table, a matrix or a KPI with its measure's format: background, data bar, icon, text -->
    <Style TargetType="renderers:FormattedValue">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="renderers:FormattedValue">
                    <Grid Background="{TemplateBinding CellBackground}">
                        <!-- The data bar, under the text -->
                        <Grid Margin="0,3" Opacity="0.4" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding BarLength, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ColumnDefinition Width="{Binding BarRest, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{TemplateBinding BarBrush}" CornerRadius="2" />
                        </Grid>
                        <!-- The icon goes right before the value, wherever the value is aligned -->
                        <TextBlock x:Name="Value" Margin="{TemplateBinding Padding}" TextAlignment="{TemplateBinding TextAlignment}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat='{}{0} '}"
                                 Foreground="{Binding IconBrush, RelativeSource={RelativeSource TemplatedParent}}" /><Run
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
