<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:local="clr-namespace:EasyBI.Wpf.Dashboard"
                    xmlns:behaviors="clr-namespace:EasyBI.Wpf.Dashboard.Behaviors"
                    xmlns:dnd="clr-namespace:EasyBI.Wpf.DragAndDrop">

    <!-- Dashboard item: a card showing its visual, or the choices of an empty item -->
    <Style TargetType="local:DashboardItem">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- The top padding leaves room for the grip and the toolbar shown on hover -->
        <Setter Property="Padding" Value="12,24,12,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DashboardItem">
                    <Grid>
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" ClipToBounds="True">
                            <Grid>
                                <bi:VisualView x:Name="View" Definition="{TemplateBinding Visual}" Context="{TemplateBinding Context}" />
                                <TextBlock x:Name="TextPlaceholder" Visibility="Collapsed" Text="{bi:Localize TextPlaceholder}"
                                           Foreground="#9CA3AF" FontStyle="Italic" IsHitTestVisible="False" />
                                <WrapPanel x:Name="Choices" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="{bi:Localize AddVisual}" Margin="4" Padding="12,6" Cursor="Hand"
                                            Command="{x:Static local:DashboardCommands.AddVisual}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Button Content="{bi:Localize AddText}" Margin="4" Padding="12,6" Cursor="Hand"
                                            Command="{x:Static local:DashboardCommands.AddText}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Button Content="{bi:Localize AddImage}" Margin="4" Padding="12,6" Cursor="Hand"
                                            Command="{x:Static local:DashboardCommands.AddImage}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Shown when an item is added next to this full-row item -->
                        <Border x:Name="FullRowBanner" Visibility="Collapsed" VerticalAlignment="Top" Margin="6,26,6,0" Padding="10,8"
                                Background="#FFF7E6" BorderBrush="#F5C26B" BorderThickness="1" CornerRadius="6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Content="{bi:Localize FullRowProceed}" Padding="8,2"
                                            Command="{x:Static local:DashboardCommands.ConfirmFullRowSplit}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Button Content="{bi:Localize Cancel}" Padding="8,2" Margin="6,0,0,0"
                                            Command="{x:Static local:DashboardCommands.CancelFullRowSplit}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                                <TextBlock Text="{bi:Localize FullRowWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Empty">
                            <Setter TargetName="View" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Choices" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="#C9CED6" />
                            <Setter TargetName="Card" Property="Background" Value="#FAFBFC" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="Text" />
                                <Condition Binding="{Binding Visual.Text.Text, RelativeSource={RelativeSource Self}}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="TextPlaceholder" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="local:DashboardView.IsReadOnly" Value="True">
                            <Setter TargetName="Choices" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TextPlaceholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsFullRowSplitPending" Value="True">
                            <Setter TargetName="FullRowBanner" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls drawn by the dashboard behaviors; an application overrides them with the same keys -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=PlusButton}" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="#2E6BE6" CornerRadius="11">
                        <TextBlock Text="+" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1E4FBF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=IconButton}" TargetType="Button">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#6B7280" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="#F2FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E5E7EB" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="#2E6BE6" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=Grip}" TargetType="ContentControl">
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="ToolTip" Value="{bi:Localize MoveItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="Transparent" Padding="4,0">
                        <TextBlock Text="⠿" FontSize="16" Foreground="#6B7280" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=ResizeGrip}" TargetType="ContentControl">
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="ToolTip" Value="{bi:Localize ResizeItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="Transparent" Width="18" Height="18">
                        <TextBlock Text="◢" FontSize="11" Foreground="#6B7280"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=DropPlaceholder}" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Rectangle Fill="#142E6BE6" Stroke="#2E6BE6" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=DragGhost}" TargetType="ContentControl">
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drag and drop: the preview following the pointer and the insertion line of a list -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type dnd:DragSource}, ResourceId=Preview}" TargetType="ContentControl">
        <Setter Property="Opacity" Value="0.95" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="White" BorderBrush="#2E6BE6" BorderThickness="1" CornerRadius="6" Padding="4,2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type dnd:DropTarget}, ResourceId=InsertionLine}" TargetType="Border">
        <Setter Property="Background" Value="#2E6BE6" />
        <Setter Property="CornerRadius" Value="1" />
    </Style>
</ResourceDictionary>
