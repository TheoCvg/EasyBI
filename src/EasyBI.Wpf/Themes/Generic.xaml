<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:local="clr-namespace:EasyBI.Wpf.Dashboard"
                    xmlns:behaviors="clr-namespace:EasyBI.Wpf.Dashboard.Behaviors"
                    xmlns:dnd="clr-namespace:EasyBI.Wpf.DragAndDrop">

    <!-- Default values of the EasyBITheme keys: the light theme -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EasyBI.Wpf;component/Themes/Light.xaml" />
        <!-- Default templates of the lookless controls -->
        <ResourceDictionary Source="/EasyBI.Wpf;component/Themes/DashboardView.xaml" />
        <ResourceDictionary Source="/EasyBI.Wpf;component/Themes/ReportDesigner.xaml" />
        <ResourceDictionary Source="/EasyBI.Wpf;component/Themes/FieldList.xaml" />
        <ResourceDictionary Source="/EasyBI.Wpf;component/Themes/FilterBar.xaml" />
        <ResourceDictionary Source="/EasyBI.Wpf;component/Themes/FilterEditor.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Dashboard item: a card showing its visual, or the choices of an empty item -->
    <Style TargetType="local:DashboardItem">
        <Setter Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- The top padding leaves room for the grip and the toolbar shown on hover -->
        <Setter Property="Padding" Value="12,24,12,12" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DashboardItem">
                    <Grid>
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource {x:Static bi:EasyBITheme.CornerRadiusKey}}"
                                Padding="{TemplateBinding Padding}" ClipToBounds="True">
                            <Grid>
                                <!-- Slots: their content takes the item as data context -->
                                <bi:SlotHost x:Name="Content" Slot="{x:Static local:DashboardSlots.ItemContent}" Orientation="Vertical"
                                             DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <bi:VisualView x:Name="View" Definition="{TemplateBinding Visual}" Context="{TemplateBinding Context}" />
                                        <TextBlock x:Name="TextPlaceholder" Visibility="Collapsed" Text="{bi:Localize TextPlaceholder}"
                                                   Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" FontStyle="Italic" IsHitTestVisible="False" />
                                    </Grid>
                                </bi:SlotHost>
                                <bi:SlotHost x:Name="Choices" Slot="{x:Static local:DashboardSlots.EmptyItemChoices}" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="{bi:Localize AddVisual}" Margin="4" Padding="12,6" Cursor="Hand"
                                                Command="{x:Static local:DashboardCommands.AddVisual}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Content="{bi:Localize AddText}" Margin="4" Padding="12,6" Cursor="Hand"
                                                Command="{x:Static local:DashboardCommands.AddText}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Content="{bi:Localize AddImage}" Margin="4" Padding="12,6" Cursor="Hand"
                                                Command="{x:Static local:DashboardCommands.AddImage}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </WrapPanel>
                                </bi:SlotHost>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Empty">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Choices" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.BorderStrongBrushKey}}" />
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, RelativeSource={RelativeSource Self}}" Value="Text" />
                                <Condition Binding="{Binding Visual.Text.Text, RelativeSource={RelativeSource Self}}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="TextPlaceholder" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="local:DashboardView.IsReadOnly" Value="True">
                            <Setter TargetName="Choices" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TextPlaceholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls drawn by the dashboard behaviors; an application overrides them with the same keys -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=PlusButton}" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" CornerRadius="11">
                        <TextBlock Text="+" Foreground="{DynamicResource {x:Static bi:EasyBITheme.AccentForegroundBrushKey}}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentHoverBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=IconButton}" TargetType="Button">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.HoverBrushKey}}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=Grip}" TargetType="ContentControl">
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="ToolTip" Value="{bi:Localize MoveItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="Transparent" Padding="4,0">
                        <TextBlock Text="⠿" FontSize="16" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=ResizeGrip}" TargetType="ContentControl">
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="ToolTip" Value="{bi:Localize ResizeItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="Transparent" Width="18" Height="18">
                        <TextBlock Text="◢" FontSize="11" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=FreeSpace}" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Frame" Stroke="{DynamicResource {x:Static bi:EasyBITheme.BorderStrongBrushKey}}" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                        <Border x:Name="Plus" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="+" Foreground="{DynamicResource {x:Static bi:EasyBITheme.AccentForegroundBrushKey}}" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBrushKey}}" />
                            <Setter TargetName="Plus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=DropPlaceholder}" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Rectangle Fill="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBrushKey}}" Stroke="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" StrokeThickness="2" Opacity="0.9" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type behaviors:DashboardOverlay}, ResourceId=DragGhost}" TargetType="ContentControl">
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drag and drop: the preview following the pointer and the insertion line of a list -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type dnd:DragSource}, ResourceId=Preview}" TargetType="ContentControl">
        <Setter Property="Opacity" Value="0.95" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" BorderThickness="1" CornerRadius="6" Padding="4,2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type dnd:DropTarget}, ResourceId=InsertionLine}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
        <Setter Property="CornerRadius" Value="1" />
    </Style>

    <!-- Why a drop is refused: a bubble under the target -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type dnd:DropTarget}, ResourceId=Refusal}" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderStrongBrushKey}}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                                   Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
