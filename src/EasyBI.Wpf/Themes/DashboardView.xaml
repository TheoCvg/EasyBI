<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:local="clr-namespace:EasyBI.Wpf.Dashboard">

    <Style TargetType="local:DashboardView">
        <Setter Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DashboardView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <bi:SlotHost Slot="{x:Static local:DashboardSlots.Body}" Orientation="Vertical">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <!-- Behaviors draw their controls (grips, "+" buttons, toolbars...) in this adorner layer, above the panel -->
                                <AdornerDecorator>
                                    <!-- Left margin: room for the band menus; bottom margin: room for the "+" adding a band at the end -->
                                    <ContentPresenter Content="{Binding Panel, RelativeSource={RelativeSource TemplatedParent}}" Margin="28,12,16,40" />
                                </AdornerDecorator>
                            </ScrollViewer>
                        </bi:SlotHost>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
