<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:local="clr-namespace:EasyBI.Wpf.Designer"
                    xmlns:dnd="clr-namespace:EasyBI.Wpf.DragAndDrop">

    <!-- Editors of the properties panel, one per kind of property (data context: the DesignerProperty); an application
         replaces one by defining a template with the same key. Controls take local values, not styles, so that the
         application's control library still applies -->
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DesignerPropertyTemplates}, ResourceId=Toggle}">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" />
    </DataTemplate>
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DesignerPropertyTemplates}, ResourceId=Choice}">
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label" />
    </DataTemplate>
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DesignerPropertyTemplates}, ResourceId=Number}">
        <TextBox Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Padding="4,2" />
    </DataTemplate>
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DesignerPropertyTemplates}, ResourceId=Text}">
        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged, Delay=400}" Padding="4,2" />
    </DataTemplate>
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DesignerPropertyTemplates}, ResourceId=Info}">
        <TextBlock Text="{Binding TextValue}" TextWrapping="Wrap" />
    </DataTemplate>
    <!-- Any object (a filter...): shown with the DataTemplate of its type -->
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DesignerPropertyTemplates}, ResourceId=Custom}">
        <ContentPresenter Content="{Binding Value}" />
    </DataTemplate>

    <!-- The template takes the designer's view-model (DesignerViewModel) as data context, and so do its slots -->
    <Style TargetType="local:ReportDesigner">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:DesignerPropertyTemplateSelector x:Key="PropertyEditors" />

            <!-- The selected filter is edited in the properties panel -->
            <DataTemplate DataType="{x:Type local:FilterItemViewModel}">
                <local:FilterEditor />
            </DataTemplate>

            <!-- Dragged chip: its caption only -->
            <DataTemplate x:Key="ChipPreviewTemplate">
                <TextBlock Text="{Binding Caption}" Margin="6,2" />
            </DataTemplate>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <ItemsPanelTemplate x:Key="WrapItems">
                <WrapPanel />
            </ItemsPanelTemplate>

            <!-- A shelf: fields are dropped on it, its chips are dragged to reorder them or move them to another shelf -->
            <Style x:Key="Shelf" TargetType="ItemsControl">
                <Setter Property="ItemsPanel" Value="{StaticResource WrapItems}" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="dnd:DropTarget.Handler" Value="{Binding}" />
                <Setter Property="dnd:DragSource.IsEnabled" Value="True" />
                <Setter Property="dnd:DragSource.AllowedEffects" Value="Move" />
                <Setter Property="dnd:DragSource.PreviewTemplate" Value="{StaticResource ChipPreviewTemplate}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ItemsControl">
                            <Border x:Name="Bd" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}"
                                    BorderThickness="1" CornerRadius="6" MinHeight="38" Padding="3">
                                <ItemsPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="dnd:DropTarget.IsDragOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ShelfLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Content" Value="✕" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                <Setter Property="Command" Value="{Binding ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=local:ReportDesigner}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.HoverBrushKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A short mark of a chip's setting (aggregation, granularity...) -->
            <DataTemplate x:Key="BadgeTemplate">
                <Border Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" CornerRadius="6" Padding="5,0" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                </Border>
            </DataTemplate>

            <!-- A chip: its caption and the marks of its settings; a click selects it (its settings are in the properties panel) -->
            <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:ShelfItemViewModel}">
                <Border x:Name="Chip" Background="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="13" Padding="10,3,4,3" Margin="3" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTemplate}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button Style="{StaticResource ChipButton}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A filter: its caption and what it keeps; a click selects it, its editor is in the properties panel -->
            <DataTemplate x:Key="FilterChipTemplate" DataType="{x:Type local:FilterItemViewModel}">
                <Border x:Name="Chip" Background="{DynamicResource {x:Static bi:EasyBITheme.SecondarySoftBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.SecondarySoftBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="13" Padding="10,3,4,3" Margin="3" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                        <ContentPresenter Content="{Binding Summary}" ContentTemplate="{StaticResource BadgeTemplate}" />
                        <Button Style="{StaticResource ChipButton}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A property: its label above its editor (a check box carries its own label, a custom editor its section's) -->
            <DataTemplate x:Key="PropertyTemplate" DataType="{x:Type local:DesignerProperty}">
                <StackPanel x:Name="Row" Margin="0,4,0,6" ToolTip="{Binding Description}" ToolTipService.ShowOnDisabled="True">
                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="11" Margin="0,0,0,3"
                               Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource PropertyEditors}" Focusable="False" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:PropertyKind.Toggle}">
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:PropertyKind.Custom}">
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                        <Setter TargetName="Row" Property="ToolTip" Value="{x:Null}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A section of the properties panel: a header that folds it -->
            <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:DesignerPropertySection}">
                <Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded}" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyTemplate}" Focusable="False" Margin="4,4,0,0" />
                </Expander>
            </DataTemplate>

            <!-- Buttons showing or hiding a side panel -->
            <Style x:Key="PanelToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ReportDesigner">
                    <!-- Three zones: the fields, the visual being built (wells and preview), its properties -->
                    <Grid DataContext="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Field panel -->
                        <bi:SlotHost x:Name="FieldPanel" Slot="{x:Static local:ReportDesignerSlots.FieldPanel}">
                            <Border Width="230" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,0,1,0" Padding="14,4,14,14">
                                <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Fields}" Orientation="Vertical">
                                    <!-- Fields are dragged onto the shelves; a double-click puts one on its default shelf -->
                                    <bi:FieldList Context="{Binding Context}" SelectedModel="{Binding SelectedModel, Mode=TwoWay}"
                                                  ActivateCommand="{Binding AddFieldCommand}" ToolTip="{bi:Localize FieldListHint}" />
                                </bi:SlotHost>
                            </Border>
                        </bi:SlotHost>

                        <!-- Visual builder -->
                        <Grid Grid.Column="1" Margin="18,12,18,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Header}">
                                <DockPanel Margin="0,0,0,10">
                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource PanelToggle}" Content="☰" Margin="0,0,10,0" ToolTip="{bi:Localize ToggleFieldPanel}"
                                                  IsChecked="{Binding IsFieldPanelOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PanelToggle}" Content="⚙" Margin="10,0,0,0" ToolTip="{bi:Localize TogglePropertiesPanel}"
                                                  IsChecked="{Binding IsPropertiesPanelOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.VisualTypes}" DockPanel.Dock="Right">
                                        <ListBox ItemsSource="{Binding MarkOptions}" SelectedValuePath="Mark"
                                                 SelectedValue="{Binding SelectedMark}" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bg" Padding="12,5" Margin="2,0" CornerRadius="5"
                                                                        BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="1" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}">
                                                                    <TextBlock x:Name="Text" Text="{Binding Label}" Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentForegroundBrushKey}}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.DisabledForegroundBrushKey}}" />
                                                                        <Setter Property="ToolTip" Value="{bi:Localize NotSupportedByRenderer}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </bi:SlotHost>
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Title}">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,16,0"
                                                 VerticalContentAlignment="Center" Padding="6,4" FontSize="14" ToolTip="{bi:Localize VisualTitle}" />
                                    </bi:SlotHost>
                                </DockPanel>
                            </bi:SlotHost>

                            <bi:SlotHost Grid.Row="1" Slot="{x:Static local:ReportDesignerSlots.Shelves}" Orientation="Vertical">
                                <StackPanel>
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.AxisShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Axis}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Axis}"
                                                          ItemsSource="{Binding Axis}" ItemTemplate="{StaticResource ChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.LegendShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Legend}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Legend}"
                                                          ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource ChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.ValuesShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Values}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Values}"
                                                          ItemsSource="{Binding Values}" ItemTemplate="{StaticResource ChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.FiltersShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Filters}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Filters}"
                                                          ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FilterChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>
                                </StackPanel>
                            </bi:SlotHost>

                            <bi:SlotHost Grid.Row="2" Slot="{x:Static local:ReportDesignerSlots.Preview}" Orientation="Vertical">
                                <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" CornerRadius="{DynamicResource {x:Static bi:EasyBITheme.CornerRadiusKey}}"
                                        BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="1">
                                    <bi:VisualView x:Name="Preview" Context="{Binding Context}" Definition="{Binding Visual}" />
                                </Border>
                            </bi:SlotHost>
                        </Grid>

                        <!-- Properties panel: the settings of the selected chip, then the visual's -->
                        <bi:SlotHost x:Name="PropertiesPanel" Grid.Column="2" Slot="{x:Static local:ReportDesignerSlots.Properties}" Orientation="Vertical">
                            <Border Width="280" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="1,0,0,0" Padding="14,4,14,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{bi:Localize Properties}" Style="{StaticResource SectionHeader}" />
                                    <TextBlock x:Name="SelectHint" DockPanel.Dock="Top" Text="{bi:Localize SelectChipHint}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,10"
                                               Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" Visibility="Collapsed" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <ItemsControl x:Name="Sections" ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </bi:SlotHost>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFieldPanelOpen" Value="False">
                            <Setter TargetName="FieldPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPropertiesPanelOpen" Value="False">
                            <Setter TargetName="PropertiesPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding ViewModel.SelectedItem, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="SelectHint" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
