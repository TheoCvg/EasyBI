<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:local="clr-namespace:EasyBI.Wpf.Designer"
                    xmlns:dnd="clr-namespace:EasyBI.Wpf.DragAndDrop"
                    xmlns:cm="clr-namespace:System.ComponentModel;assembly=System">

    <!-- The template takes the designer's view-model (DesignerViewModel) as data context, and so do its slots -->
    <Style TargetType="local:ReportDesigner">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Dragged chip: its caption only (the chip's own combo boxes stay on the shelf) -->
            <DataTemplate x:Key="ChipPreviewTemplate">
                <TextBlock Text="{Binding Caption}" Margin="6,2" />
            </DataTemplate>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <ItemsPanelTemplate x:Key="WrapItems">
                <WrapPanel />
            </ItemsPanelTemplate>

            <!-- A shelf: fields are dropped on it, its chips are dragged to reorder them or move them to another shelf -->
            <Style x:Key="Shelf" TargetType="ItemsControl">
                <Setter Property="ItemsPanel" Value="{StaticResource WrapItems}" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="dnd:DropTarget.Handler" Value="{Binding}" />
                <Setter Property="dnd:DragSource.IsEnabled" Value="True" />
                <Setter Property="dnd:DragSource.AllowedEffects" Value="Move" />
                <Setter Property="dnd:DragSource.PreviewTemplate" Value="{StaticResource ChipPreviewTemplate}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ItemsControl">
                            <Border x:Name="Bd" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}"
                                    BorderThickness="1" CornerRadius="6" MinHeight="38" Padding="3">
                                <ItemsPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="dnd:DropTarget.IsDragOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ShelfLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Content" Value="✕" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                <Setter Property="Command" Value="{Binding ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=local:ReportDesigner}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.HoverBrushKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:ShelfItemViewModel}">
                <!-- Combo boxes take local values, not a style: the application's ComboBox style still applies -->
                <Border Background="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.AccentSoftBorderBrushKey}}" BorderThickness="1" CornerRadius="13" Padding="10,3,4,3" Margin="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                        <ComboBox Margin="6,0,0,0" FontSize="11" Padding="4,1" MinWidth="70" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  Visibility="{Binding HasGrain, Converter={StaticResource BoolToVisibility}}"
                                  ItemsSource="{x:Static local:ShelfItemViewModel.GrainOptions}"
                                  SelectedValue="{Binding Grain, Mode=TwoWay}" />
                        <ComboBox Margin="6,0,0,0" FontSize="11" Padding="4,1" MinWidth="70" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  Visibility="{Binding HasAggregation, Converter={StaticResource BoolToVisibility}}"
                                  ItemsSource="{x:Static local:ShelfItemViewModel.AggregationOptions}"
                                  SelectedValue="{Binding Aggregation, Mode=TwoWay}" />
                        <!-- A measure seen through time: previous year, change, year to date -->
                        <ComboBox Margin="6,0,0,0" FontSize="11" Padding="4,1" MinWidth="70" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="{bi:Localize TimeHint}"
                                  Visibility="{Binding IsValue, Converter={StaticResource BoolToVisibility}}"
                                  ItemsSource="{x:Static local:ShelfItemViewModel.TimeOptions}"
                                  SelectedValue="{Binding Time, Mode=TwoWay}" />
                        <!-- Measures of a cartesian chart: chart type and value axis of their series -->
                        <ComboBox Margin="6,0,0,0" FontSize="11" Padding="4,1" MinWidth="70" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="{bi:Localize SeriesMarkHint}"
                                  Visibility="{Binding ShowSeriesOptions, Converter={StaticResource BoolToVisibility}}"
                                  ItemsSource="{x:Static local:ShelfItemViewModel.SeriesMarkOptions}"
                                  SelectedItem="{Binding SeriesMarkOption, Mode=TwoWay}" />
                        <ToggleButton Content="{bi:Localize SecondaryAxis}" ToolTip="{bi:Localize SecondaryAxisHint}"
                                      Margin="4,0,0,0" Padding="5,0" FontSize="11" Cursor="Hand"
                                      Visibility="{Binding ShowSeriesOptions, Converter={StaticResource BoolToVisibility}}"
                                      IsChecked="{Binding SecondaryAxis, Mode=TwoWay}" />
                        <!-- Sort on this field: a menu showing the current direction -->
                        <Menu Margin="4,0,0,0" Background="Transparent" VerticalAlignment="Center" ToolTip="{bi:Localize SortHint}"
                              Visibility="{Binding CanSort, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem Header="{Binding SortOption.Symbol}" Padding="5,0" FontSize="11" Cursor="Hand">
                                <MenuItem Command="{Binding SortCommand}">
                                    <MenuItem.Header>
                                        <TextBlock><Run Text="⇅ " /><Run Text="{bi:Localize SortNone}" /></TextBlock>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding SortCommand}" CommandParameter="{x:Static cm:ListSortDirection.Ascending}">
                                    <MenuItem.Header>
                                        <TextBlock><Run Text="↑ " /><Run Text="{bi:Localize SortAscending}" /></TextBlock>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding SortCommand}" CommandParameter="{x:Static cm:ListSortDirection.Descending}">
                                    <MenuItem.Header>
                                        <TextBlock><Run Text="↓ " /><Run Text="{bi:Localize SortDescending}" /></TextBlock>
                                    </MenuItem.Header>
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                        <Button Style="{StaticResource ChipButton}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="FilterChipTemplate" DataType="{x:Type local:FilterItemViewModel}">
                <Border Background="{DynamicResource {x:Static bi:EasyBITheme.SecondarySoftBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.SecondarySoftBorderBrushKey}}" BorderThickness="1" CornerRadius="13" Padding="10,3,4,3" Margin="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding Caption, Mode=OneWay}" /><Run Text="{bi:Localize LabelSuffix}" /></TextBlock>
                        <ToggleButton x:Name="Toggle" Margin="6,0,0,0" Padding="6,1" FontSize="11"
                                      Content="{Binding Summary}" IsEnabled="{Binding IsLoading, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=Toggle}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" AllowsTransparency="True">
                            <Border Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="1"
                                    CornerRadius="6" Padding="8" MaxHeight="300" MinWidth="160">
                                <local:FilterEditor />
                            </Border>
                        </Popup>
                        <Button Style="{StaticResource ChipButton}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ReportDesigner">
                    <Grid DataContext="{Binding ViewModel, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Field panel -->
                        <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.FieldPanel}">
                            <Border Width="230" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,0,1,0" Padding="14,4,14,14">
                                <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Fields}" Orientation="Vertical">
                                    <!-- Fields are dragged onto the shelves; a double-click puts one on its default shelf -->
                                    <bi:FieldList Context="{Binding Context}" SelectedModel="{Binding SelectedModel, Mode=TwoWay}"
                                                  ActivateCommand="{Binding AddFieldCommand}" ToolTip="{bi:Localize FieldListHint}" />
                                </bi:SlotHost>
                            </Border>
                        </bi:SlotHost>

                        <!-- Visual builder -->
                        <Grid Grid.Column="1" Margin="18,12,18,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Header}">
                                <DockPanel Margin="0,0,0,10">
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.VisualTypes}" DockPanel.Dock="Right">
                                        <ListBox ItemsSource="{Binding MarkOptions}" SelectedValuePath="Mark"
                                                 SelectedValue="{Binding SelectedMark}" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bg" Padding="12,5" Margin="2,0" CornerRadius="5"
                                                                        BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="1" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}">
                                                                    <TextBlock x:Name="Text" Text="{Binding Label}" Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" />
                                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.AccentForegroundBrushKey}}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.DisabledForegroundBrushKey}}" />
                                                                        <Setter Property="ToolTip" Value="{bi:Localize NotSupportedByRenderer}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </bi:SlotHost>
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Title}">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,16,0"
                                                 VerticalContentAlignment="Center" Padding="6,4" FontSize="14" ToolTip="{bi:Localize VisualTitle}" />
                                    </bi:SlotHost>
                                </DockPanel>
                            </bi:SlotHost>

                            <bi:SlotHost Grid.Row="1" Slot="{x:Static local:ReportDesignerSlots.Shelves}" Orientation="Vertical">
                                <StackPanel>
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.AxisShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Axis}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Axis}"
                                                          ItemsSource="{Binding Axis}" ItemTemplate="{StaticResource ChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.LegendShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Legend}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Legend}"
                                                          ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource ChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.ValuesShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Values}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Values}"
                                                          ItemsSource="{Binding Values}" ItemTemplate="{StaticResource ChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.FiltersShelf}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Filters}" Style="{StaticResource ShelfLabel}" />
                                            <ItemsControl Grid.Column="1" Style="{StaticResource Shelf}" dnd:DropTarget.Key="{x:Static local:Shelf.Filters}"
                                                          ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FilterChipTemplate}" />
                                        </Grid>
                                    </bi:SlotHost>

                                    <!-- The active sort (chosen on a chip) and the number of rows shown -->
                                    <bi:SlotHost Slot="{x:Static local:ReportDesignerSlots.Sort}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{bi:Localize Sort}" Style="{StaticResource ShelfLabel}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                                <TextBlock x:Name="SortSummary" Text="{Binding SortSummary}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="NoSort" Text="{bi:Localize NoSort}" VerticalAlignment="Center" Visibility="Collapsed"
                                                           Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                                                <TextBlock Text="{bi:Localize Top}" Style="{StaticResource ShelfLabel}" Margin="18,0,6,0" />
                                                <TextBox Width="50" Padding="4,1" VerticalContentAlignment="Center" ToolTip="{bi:Localize TopHint}"
                                                         Text="{Binding Top, TargetNullValue='', UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                            </StackPanel>
                                        </Grid>
                                    </bi:SlotHost>
                                </StackPanel>
                            </bi:SlotHost>

                            <!-- Options of the renderer: a check box, a list or a number box each -->
                            <bi:SlotHost Grid.Row="2" Slot="{x:Static local:ReportDesignerSlots.RendererOptions}">
                                <Grid Margin="0,6,0,0" Visibility="{Binding HasRendererOptions, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{bi:Localize RendererOptions}" Style="{StaticResource ShelfLabel}" />
                                    <ItemsControl x:Name="RendererOptionList" Grid.Column="1" ItemsSource="{Binding RendererOptions}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:RendererOptionViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="4,3,18,3" ToolTip="{Binding Description}">
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsOn}" Margin="0,0,6,0"
                                                              Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <ComboBox Margin="6,0,0,0" MinWidth="90" DisplayMemberPath="Label"
                                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBox Margin="6,0,0,0" Width="60" Padding="4,1" Text="{Binding NumberText}"
                                                             Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </bi:SlotHost>

                            <bi:SlotHost Grid.Row="3" Slot="{x:Static local:ReportDesignerSlots.Preview}" Orientation="Vertical">
                                <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" CornerRadius="{DynamicResource {x:Static bi:EasyBITheme.CornerRadiusKey}}"
                                        BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="1">
                                    <bi:VisualView x:Name="Preview" Context="{Binding Context}" Definition="{Binding Visual}" />
                                </Border>
                            </bi:SlotHost>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.SortSummary, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="SortSummary" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NoSort" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
