<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:designer="clr-namespace:EasyBI.Wpf.Designer">

    <!-- The content of a filter's popup (DataContext: a FilterItemViewModel), in the designer and in the filter bar -->
    <Style TargetType="designer:FilterEditor">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="Visible" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="designer:FilterEditor">
                    <DockPanel>
                        <!-- A variable of the report instead of the values: a set, a parameter -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasVariableChoices, Converter={StaticResource Visible}}">
                            <TextBlock Text="{bi:Localize FilterVariable}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding VariableChoices}" SelectedItem="{Binding VariableChoice}" DisplayMemberPath="Label" />
                        </DockPanel>
                        <!-- A number: a list of values (dimension) or any value (measure), or a comparison -->
                        <ComboBox DockPanel.Dock="Top" Margin="0,0,0,8" MinWidth="250"
                                  ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" DisplayMemberPath="Label"
                                  Visibility="{Binding HasConditions, Converter={StaticResource Visible}}" />
                        <Grid>
                            <!-- Compared with one number, or between two -->
                            <bi:SlotHost Slot="{x:Static designer:FilterEditorSlots.Comparison}" Orientation="Vertical"
                                         Visibility="{Binding IsComparison, Converter={StaticResource Visible}}">
                                <DockPanel>
                                    <TextBox Width="110" Padding="4,2" VerticalContentAlignment="Center" ToolTip="{bi:Localize ConditionNumber}"
                                             Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsNumberTyped, Converter={StaticResource Visible}}" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSecondNumber, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{bi:Localize ConditionAnd}" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Width="110" Padding="4,2" VerticalContentAlignment="Center" ToolTip="{bi:Localize ConditionNumber}"
                                                 Text="{Binding SecondNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </DockPanel>
                            </bi:SlotHost>

                            <!-- Values to check -->
                            <bi:SlotHost Slot="{x:Static designer:FilterEditorSlots.Values}" Orientation="Vertical"
                                         Visibility="{Binding IsValueList, Converter={StaticResource Visible}}">
                                <DockPanel MinWidth="250">
                                    <!-- Many values: a search box (only the values shown change, the checked ones stay checked) -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding ShowSearch, Converter={StaticResource Visible}}">
                                        <TextBox Padding="6,3" VerticalContentAlignment="Center" ToolTip="{bi:Localize SearchValues}"
                                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                        <TextBlock x:Name="SearchPlaceholder" Text="{bi:Localize SearchValues}" Margin="9,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" Visibility="Collapsed" FontStyle="Italic"
                                                   Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                                    </Grid>
                                    <!-- More values than listed: the search finds the others in the model -->
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" MaxWidth="250" HorizontalAlignment="Left" TextWrapping="Wrap"
                                               FontStyle="Italic" Text="{bi:Localize FilterTruncated}"
                                               Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}"
                                               Visibility="{Binding IsTruncated, Converter={StaticResource Visible}}" />
                                    <!-- As in Excel: (Select all), checked, unchecked or partly; while searching, on the values found -->
                                    <CheckBox DockPanel.Dock="Top" Margin="0,2" IsThreeState="False" IsChecked="{Binding AllChecked}">
                                        <Grid>
                                            <TextBlock x:Name="SelectAll" Text="{bi:Localize FilterSelectAll}" />
                                            <TextBlock x:Name="SelectAllResults" Text="{bi:Localize FilterSelectAllResults}" Visibility="Collapsed" />
                                        </Grid>
                                    </CheckBox>
                                    <CheckBox x:Name="AddToFilter" DockPanel.Dock="Top" Margin="0,2" Visibility="Collapsed"
                                              IsChecked="{Binding AddToFilter}" Content="{bi:Localize FilterAddToFilter}" />
                                    <Separator DockPanel.Dock="Top" Margin="0,4" />
                                    <!-- Virtualized: a dimension can have thousands of values -->
                                    <ItemsControl ItemsSource="{Binding VisibleValues}" MaxHeight="284"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                                              CanContentScroll="True">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </bi:SlotHost>

                            <!-- A period of a date: between two dates, or relative to today -->
                            <bi:SlotHost Slot="{x:Static designer:FilterEditorSlots.Period}" Orientation="Vertical"
                                         Visibility="{Binding IsPeriod, Converter={StaticResource Visible}}">
                                <StackPanel MinWidth="250">
                                    <ComboBox ItemsSource="{Binding PeriodKinds}" SelectedItem="{Binding PeriodKind}" DisplayMemberPath="Label"
                                              Visibility="{Binding ShowPeriod, Converter={StaticResource Visible}}" />
                                    <Grid Margin="0,8,0,0" Visibility="{Binding ShowDates, Converter={StaticResource Visible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{bi:Localize PeriodFrom}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding From}" />
                                        <TextBlock Grid.Row="1" Text="{bi:Localize PeriodTo}" VerticalAlignment="Center" Margin="0,6,8,0" />
                                        <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" SelectedDate="{Binding To}" />
                                    </Grid>
                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowUnit, Converter={StaticResource Visible}}">
                                        <TextBox DockPanel.Dock="Left" Width="56" Margin="0,0,8,0" Padding="4,2" VerticalContentAlignment="Center"
                                                 ToolTip="{bi:Localize PeriodCount}"
                                                 Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding ShowCount, Converter={StaticResource Visible}}" />
                                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" DisplayMemberPath="Label" />
                                    </DockPanel>
                                </StackPanel>
                            </bi:SlotHost>
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Search}" Value="">
                            <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                            <Setter TargetName="SelectAll" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectAllResults" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AddToFilter" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
