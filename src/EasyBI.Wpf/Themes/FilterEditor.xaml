<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bi="clr-namespace:EasyBI.Wpf"
                    xmlns:designer="clr-namespace:EasyBI.Wpf.Designer">

    <!-- The content of a filter's popup (DataContext: a FilterItemViewModel), in the designer and in the filter bar -->
    <Style TargetType="designer:FilterEditor">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="Visible" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="designer:FilterEditor">
                    <Grid>
                        <!-- Values to check -->
                        <bi:SlotHost Slot="{x:Static designer:FilterEditorSlots.Values}" Orientation="Vertical"
                                     Visibility="{Binding IsValueList, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <!-- Many values: a search box (only the values shown change, the checked ones stay checked) -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding ShowSearch, Converter={StaticResource Visible}}">
                                    <TextBox Padding="6,3" VerticalContentAlignment="Center" ToolTip="{bi:Localize SearchValues}"
                                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock x:Name="SearchPlaceholder" Text="{bi:Localize SearchValues}" Margin="9,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Visibility="Collapsed" FontStyle="Italic"
                                               Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                                </Grid>
                                <ScrollViewer MaxHeight="284" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding VisibleValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </bi:SlotHost>

                        <!-- A period of a date: between two dates, or relative to today -->
                        <bi:SlotHost Slot="{x:Static designer:FilterEditorSlots.Period}" Orientation="Vertical"
                                     Visibility="{Binding IsPeriod, Converter={StaticResource Visible}}">
                            <StackPanel MinWidth="250">
                                <ComboBox ItemsSource="{Binding PeriodKinds}" SelectedItem="{Binding PeriodKind}" DisplayMemberPath="Label" />
                                <Grid Margin="0,8,0,0" Visibility="{Binding ShowDates, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{bi:Localize PeriodFrom}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding From}" />
                                    <TextBlock Grid.Row="1" Text="{bi:Localize PeriodTo}" VerticalAlignment="Center" Margin="0,6,8,0" />
                                    <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" SelectedDate="{Binding To}" />
                                </Grid>
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowUnit, Converter={StaticResource Visible}}">
                                    <TextBox DockPanel.Dock="Left" Width="56" Margin="0,0,8,0" Padding="4,2" VerticalContentAlignment="Center"
                                             ToolTip="{bi:Localize PeriodCount}"
                                             Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding ShowCount, Converter={StaticResource Visible}}" />
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" DisplayMemberPath="Label" />
                                </DockPanel>
                            </StackPanel>
                        </bi:SlotHost>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Search}" Value="">
                            <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
