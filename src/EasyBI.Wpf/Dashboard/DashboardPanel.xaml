<UserControl x:Class="EasyBI.Wpf.Dashboard.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bi="clr-namespace:EasyBI.Wpf"
             xmlns:local="clr-namespace:EasyBI.Wpf.Dashboard"
             xmlns:core="clr-namespace:EasyBI.Abstractions;assembly=EasyBI.Abstractions"
>
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2E6BE6" />
        <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />

        <Style x:Key="PlusButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource AccentBrush}" CornerRadius="11">
                            <TextBlock Text="+" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1E4FBF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F2FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ResizeGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <TextBlock Text="◢" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One item: a visual, a text, an image or an empty placeholder -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type local:DashboardItemViewModel}">
            <Grid x:Name="Root" Background="Transparent">
                <Border x:Name="Card" Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Padding="12,22,12,12" ClipToBounds="True">
                    <Grid>
                        <bi:VisualView x:Name="View" Definition="{Binding Visual}" Visibility="Collapsed"
                                       Context="{Binding Context, RelativeSource={RelativeSource AncestorType=local:DashboardPanel}}" />

                        <TextBlock x:Name="TextDisplay" Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="{Binding Text.Text}" FontSize="{Binding Text.FontSize}"
                                   Background="Transparent" MouseLeftButtonDown="OnTextMouseDown" />
                        <TextBlock x:Name="TextPlaceholder" Visibility="Collapsed" Text="{bi:Localize TextPlaceholder}"
                                   Foreground="#9CA3AF" FontStyle="Italic" IsHitTestVisible="False" />
                        <TextBox x:Name="TextEditor" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F9FAFB"
                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" FontSize="{Binding Text.FontSize}"
                                 IsVisibleChanged="OnTextEditorVisibleChanged" LostKeyboardFocus="OnTextEditorLostFocus"
                                 PreviewKeyDown="OnTextEditorKeyDown" />

                        <Image x:Name="Picture" Visibility="Collapsed" Source="{Binding ImageSource}" Stretch="Uniform" />

                        <WrapPanel x:Name="Choices" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="{bi:Localize AddVisual}" Style="{StaticResource ChoiceButton}" Click="OnAddVisual" />
                            <Button Content="{bi:Localize AddText}" Style="{StaticResource ChoiceButton}" Click="OnAddText" />
                            <Button Content="{bi:Localize AddImage}" Style="{StaticResource ChoiceButton}" Click="OnAddImage" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Banner shown when "+" is used next to a full-row item -->
                <Border x:Name="FullRowBanner" Visibility="Collapsed" VerticalAlignment="Top" Margin="6,26,6,0" Padding="10,8"
                        Background="#FFF7E6" BorderBrush="#F5C26B" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Content="{bi:Localize FullRowProceed}" Padding="8,2" Click="OnFullRowProceed" />
                            <Button Content="{bi:Localize Cancel}" Padding="8,2" Margin="6,0,0,0" Click="OnFullRowCancel" />
                        </StackPanel>
                        <TextBlock Text="{bi:Localize FullRowWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock x:Name="Grip" Text="⠿" FontSize="16" Margin="8,2,0,0" Cursor="SizeAll"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{StaticResource MutedBrush}"
                           Visibility="Hidden" ToolTip="{bi:Localize MoveItem}" Background="Transparent"
                           PreviewMouseLeftButtonDown="OnGripMouseDown" PreviewMouseMove="OnGripMouseMove"
                           PreviewMouseLeftButtonUp="OnGripMouseUp" />
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" Margin="0,1,6,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden">
                    <StackPanel x:Name="TextTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" Content="A−" Click="OnTextSmaller" ToolTip="{bi:Localize TextSmaller}" />
                        <Button Style="{StaticResource IconButton}" Content="A+" Click="OnTextLarger" ToolTip="{bi:Localize TextLarger}" />
                        <Button Style="{StaticResource IconButton}" Content="B" FontWeight="Bold" Click="OnTextBold" ToolTip="{bi:Localize TextBold}" />
                        <Button Style="{StaticResource IconButton}" Content="≡" Click="OnTextAlignment" ToolTip="{bi:Localize TextAlignment}" />
                    </StackPanel>
                    <Button x:Name="FitButton" Style="{StaticResource IconButton}" Content="⤢" Visibility="Collapsed"
                            Click="OnImageFit" ToolTip="{bi:Localize ImageFit}" />
                    <Button x:Name="FullRowButton" Style="{StaticResource IconButton}" Content="↔" Click="OnToggleFullRow"
                            ToolTip="{bi:Localize FullRow}" />
                    <Button x:Name="EditButton" Style="{StaticResource IconButton}" Content="✎" Visibility="Collapsed"
                            Click="OnEditItem" ToolTip="{bi:Localize EditVisual}" />
                    <Button Style="{StaticResource IconButton}" Content="✕" FontSize="10" Click="OnRemoveItem"
                            ToolTip="{bi:Localize RemoveItem}" />
                </StackPanel>

                <!-- Edge zones: hovering shows a "+" centred on the edge -->
                <Grid x:Name="RightZone" Width="16" HorizontalAlignment="Right" Margin="0,30,0,24" Background="Transparent">
                    <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RightPlus" Canvas.Left="-4" Canvas.Top="-11" Style="{StaticResource PlusButton}"
                                Click="OnAddRight" ToolTip="{bi:Localize AddRight}" />
                    </Canvas>
                </Grid>
                <Grid x:Name="BottomZone" Height="16" VerticalAlignment="Bottom" Margin="24,0,24,0" Background="Transparent">
                    <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button x:Name="BottomPlus" Canvas.Left="-11" Canvas.Top="-4" Style="{StaticResource PlusButton}"
                                Click="OnAddBelow" ToolTip="{bi:Localize AddBelow}" />
                    </Canvas>
                </Grid>

                <Thumb x:Name="Resizer" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Style="{StaticResource ResizeGrip}" Cursor="SizeNWSE" Visibility="Hidden" ToolTip="{bi:Localize ResizeItem}"
                       DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DashboardItemKind.Visual}">
                    <Setter TargetName="View" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DashboardItemKind.Text}">
                    <Setter TargetName="TextDisplay" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TextTools" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EditButton" Property="ToolTip" Value="{bi:Localize EditText}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="{x:Static local:DashboardItemKind.Text}" />
                        <Condition Binding="{Binding IsTextEmpty}" Value="True" />
                        <Condition Binding="{Binding IsEditingText}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TextPlaceholder" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsEditingText}" Value="True">
                    <Setter TargetName="TextDisplay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TextEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text.IsBold}" Value="True">
                    <Setter TargetName="TextDisplay" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="TextEditor" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text.Alignment}" Value="{x:Static core:TextAlign.Center}">
                    <Setter TargetName="TextDisplay" Property="TextAlignment" Value="Center" />
                    <Setter TargetName="TextEditor" Property="TextAlignment" Value="Center" />
                    <Setter TargetName="TextPlaceholder" Property="HorizontalAlignment" Value="Center" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text.Alignment}" Value="{x:Static core:TextAlign.Right}">
                    <Setter TargetName="TextDisplay" Property="TextAlignment" Value="Right" />
                    <Setter TargetName="TextEditor" Property="TextAlignment" Value="Right" />
                    <Setter TargetName="TextPlaceholder" Property="HorizontalAlignment" Value="Right" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DashboardItemKind.Image}">
                    <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FitButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EditButton" Property="ToolTip" Value="{bi:Localize ChangeImage}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Image.Fit}" Value="{x:Static core:ImageFit.Cover}">
                    <Setter TargetName="Picture" Property="Stretch" Value="UniformToFill" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Image.Fit}" Value="{x:Static core:ImageFit.Stretch}">
                    <Setter TargetName="Picture" Property="Stretch" Value="Fill" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DashboardItemKind.Empty}">
                    <Setter TargetName="Choices" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#C9CED6" />
                    <Setter TargetName="Card" Property="Background" Value="#FAFBFC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFullRow}" Value="True">
                    <Setter TargetName="FullRowButton" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="FullRowButton" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowFullRowWarning}" Value="True">
                    <Setter TargetName="FullRowBanner" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- In scrolling and wrapping bands items follow each other: "+" only on the right -->
                <DataTrigger Binding="{Binding Band.Mode}" Value="{x:Static core:BandMode.Scroll}">
                    <Setter TargetName="BottomZone" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Band.Mode}" Value="{x:Static core:BandMode.Wrap}">
                    <Setter TargetName="BottomZone" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Toolbar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Resizer" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="RightZone" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RightPlus" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="BottomZone" Property="IsMouseOver" Value="True">
                    <Setter TargetName="BottomPlus" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsLayoutEditable, RelativeSource={RelativeSource AncestorType=local:DashboardPanel}}" Value="False">
                    <Setter TargetName="Grip" Property="Opacity" Value="0" />
                    <Setter TargetName="Grip" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="Toolbar" Property="Opacity" Value="0" />
                    <Setter TargetName="Toolbar" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="Resizer" Property="Opacity" Value="0" />
                    <Setter TargetName="Resizer" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="RightZone" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BottomZone" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Choices" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TextDisplay" Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Items of a band, laid out according to its mode -->
        <Style x:Key="BandItems" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="AllowDrop" Value="True" />
            <!-- Fit: a grid of cells -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <local:DashboardGridPanel Columns="{Binding Columns}" RowHeight="{Binding RowHeight}" Gap="14"
                                                  Loaded="OnGridLoaded" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="local:DashboardGridPanel.Column" Value="{Binding Column}" />
                        <Setter Property="local:DashboardGridPanel.Row" Value="{Binding Row}" />
                        <Setter Property="local:DashboardGridPanel.ColumnSpan" Value="{Binding ColumnSpan}" />
                        <Setter Property="local:DashboardGridPanel.RowSpan" Value="{Binding RowSpan}" />
                        <Style.Triggers>
                            <!-- The hovered item draws over its neighbours, so its "+" is never hidden -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:BandMode.Scroll}">
                    <Setter Property="Margin" Value="0,0,-14,0" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ItemContainerStyle" Value="{DynamicResource StripItem}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Background="{TemplateBinding Background}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:BandMode.Wrap}">
                    <Setter Property="Margin" Value="0,0,-14,0" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ItemContainerStyle" Value="{DynamicResource StripItem}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Item of a scrolling or wrapping band: its own width (or the whole band), a height in grid rows -->
        <Style x:Key="StripItem" TargetType="ContentPresenter">
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullRow}" Value="True">
                    <!-- The band is one gap wider than what is visible (it absorbs the last item's margin) -->
                    <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl},
                            Converter={x:Static local:MinusGapConverter.Instance}}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One band: options gutter on the left, items, then a gap with "+" to insert a band -->
        <DataTemplate x:Key="BandTemplate" DataType="{x:Type local:DashboardBandViewModel}">
            <Grid x:Name="BandRoot" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Button x:Name="BandOptions" Style="{StaticResource IconButton}" Content="⋮" FontSize="14"
                        VerticalAlignment="Top" Margin="0,4,2,0" Visibility="Hidden" Click="OnBandOptions"
                        ToolTip="{bi:Localize BandOptions}" />

                <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}" Style="{StaticResource BandItems}"
                              DragEnter="OnBandDragOver" DragOver="OnBandDragOver" Drop="OnBandDrop" />

                <Grid x:Name="BandGap" Grid.Row="1" Grid.Column="1" Background="Transparent">
                    <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BandPlus" Canvas.Left="-11" Canvas.Top="-11" Style="{StaticResource PlusButton}"
                                Click="OnInsertBand" ToolTip="{bi:Localize AddBand}" />
                    </Canvas>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="BandRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="BandOptions" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="BandGap" Property="IsMouseOver" Value="True">
                    <Setter TargetName="BandPlus" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsLayoutEditable, RelativeSource={RelativeSource AncestorType=local:DashboardPanel}}" Value="False">
                    <Setter TargetName="BandOptions" Property="Opacity" Value="0" />
                    <Setter TargetName="BandOptions" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="BandGap" Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,8,16,16">
            <ItemsControl x:Name="BandList" ItemTemplate="{StaticResource BandTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <!-- The hovered band draws over the next one, so a "+" overflowing it stays visible -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <Button x:Name="AddAtEnd" Content="{bi:Localize AddAtEnd}" HorizontalAlignment="Center" Margin="24,0,0,0"
                    Padding="14,6" Cursor="Hand" Click="OnAddAtEnd" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
