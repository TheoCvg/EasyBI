<Window x:Class="EasyBI.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bi="https://github.com/TheoCvg/EasyBI"
        xmlns:local="clr-namespace:EasyBI.Sample"
        Title="{bi:Localize WindowTitle, Source={x:Static local:App.Texts}}" Width="1280" Height="860" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}" FontFamily="Segoe UI" FontSize="13">
    <!-- The background is on the root panel, not the window: WPF UI sets the main window's background itself -->
    <DockPanel Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,0,0,1" Padding="18,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{bi:Localize Open, Source={x:Static local:App.Texts}}" Padding="12,5" Click="OnOpen" />
                        <Button Content="{bi:Localize Save, Source={x:Static local:App.Texts}}" Padding="12,5" Margin="6,0,0,0" Click="OnSave" />
                    </StackPanel>
                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold">
                        <Run Text="EasyBI" Foreground="{DynamicResource {x:Static bi:EasyBITheme.AccentBrushKey}}" /><Run Text="{bi:Localize Tagline, Source={x:Static local:App.Texts}}" />
                    </TextBlock>
                </DockPanel>
                <!-- Theme: EasyBI alone or following a control library, light or dark. No explicit control styles in
                     the demo: they would hide the library's implicit ones -->
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="{bi:Localize ThemeLibrary, Source={x:Static local:App.Texts}}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    <ComboBox x:Name="LibraryPicker" Width="150" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Tag="EasyBI" Content="EasyBI" IsSelected="True" />
                        <ComboBoxItem Tag="WpfUi" Content="WPF UI" />
                        <ComboBoxItem Tag="MaterialDesign" Content="Material Design" />
                    </ComboBox>
                    <TextBlock Text="{bi:Localize Theme, Source={x:Static local:App.Texts}}" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    <ComboBox x:Name="ThemePicker" Width="110" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Tag="Light" Content="{bi:Localize ThemeLight, Source={x:Static local:App.Texts}}" IsSelected="True" />
                        <ComboBoxItem Tag="Dark" Content="{bi:Localize ThemeDark, Source={x:Static local:App.Texts}}" />
                    </ComboBox>
                    <TextBlock Text="{bi:Localize Language, Source={x:Static local:App.Texts}}" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    <ComboBox x:Name="LanguagePicker" Width="150" DisplayMemberPath="NativeName" SelectionChanged="OnLanguageChanged" />
                    <TextBlock Text="{bi:Localize Renderer, Source={x:Static local:App.Texts}}" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    <ComboBox x:Name="RendererPicker" Width="140" DisplayMemberPath="Name" SelectionChanged="OnRendererChanged" />
                    <!-- Data source: the same sales in memory or in a SQLite database of millions of rows -->
                    <TextBlock Text="{bi:Localize DataSource, Source={x:Static local:App.Texts}}" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                    <ComboBox x:Name="SourcePicker" Width="220" SelectionChanged="OnSourceChanged">
                        <ComboBoxItem Tag="0" Content="{bi:Localize DataSourceMemory, Source={x:Static local:App.Texts}}" IsSelected="True" />
                        <ComboBoxItem Tag="1000000" Content="{bi:Localize DataSourceSqlite1M, Source={x:Static local:App.Texts}}" />
                        <ComboBoxItem Tag="5000000" Content="{bi:Localize DataSourceSqlite5M, Source={x:Static local:App.Texts}}" />
                    </ComboBox>
                    <TextBlock x:Name="QueryStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12" Padding="0" Background="{DynamicResource {x:Static bi:EasyBITheme.BackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}">
            <TabItem Header="{bi:Localize DashboardTab, Source={x:Static local:App.Texts}}">
                <!-- The FilterContext set here is inherited by the filter bar and by every visual -->
                <DockPanel bi:VisualView.FilterContext="{Binding Filters}">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,0,0,1" Padding="18,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{bi:Localize Undo, Source={x:Static local:App.Texts}}" Padding="8,2" Margin="4,0,0,0" FontSize="12"
                                        Command="Undo" CommandTarget="{Binding ElementName=Dashboard}" />
                                <Button Content="{bi:Localize Redo, Source={x:Static local:App.Texts}}" Padding="8,2" Margin="4,0,0,0" FontSize="12"
                                        Command="Redo" CommandTarget="{Binding ElementName=Dashboard}" />
                                <CheckBox Content="{bi:Localize ReadOnly, Source={x:Static local:App.Texts}}" VerticalAlignment="Center" Margin="12,0,0,0"
                                          Foreground="{DynamicResource {x:Static bi:EasyBITheme.ForegroundBrushKey}}"
                                          IsChecked="{Binding IsReadOnly, ElementName=Dashboard}" />
                            </StackPanel>
                            <StackPanel>
                                <bi:FilterBar Context="{Binding Context}" />
                                <TextBlock Text="{bi:Localize Tip, Source={x:Static local:App.Texts}}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static bi:EasyBITheme.MutedForegroundBrushKey}}" FontSize="11" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Fields to drag onto the dashboard (hidden while it is read-only) -->
                    <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource {x:Static bi:EasyBITheme.SurfaceAltBrushKey}}" BorderBrush="{DynamicResource {x:Static bi:EasyBITheme.BorderBrushKey}}" BorderThickness="0,0,1,0" Padding="14,0,14,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly, ElementName=Dashboard}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <bi:FieldList Context="{Binding Context}" />
                    </Border>
                    <!-- Interactions are behaviors attached by default; Interaction.Behaviors can replace or configure them -->
                    <bi:DashboardView x:Name="Dashboard" Context="{Binding Context}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="{bi:Localize DesignerTab, Source={x:Static local:App.Texts}}">
                <!-- The designer shows the window's DesignerViewModel; the application's buttons go into a slot, under the preview -->
                <bi:ReportDesigner DataContext="{Binding Designer}">
                    <bi:Slots.Items>
                        <bi:Slot Name="{x:Static bi:ReportDesignerSlots.Preview}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="{bi:Localize NewVisual, Source={x:Static local:App.Texts}}" Padding="12,5" Margin="6,0,0,0" Click="OnNewVisual" />
                                <Button x:Name="PublishButton" Padding="12,5" Margin="6,0,0,0"
                                        Click="OnPublishVisual" FontWeight="SemiBold" />
                            </StackPanel>
                        </bi:Slot>
                    </bi:Slots.Items>
                </bi:ReportDesigner>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
