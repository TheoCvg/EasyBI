<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework runs the net462 build of the libraries: both must behave the same -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same culture setup as the Core tests: invariant by default, opt-in culture collection -->
    <Compile Include="..\EasyBI.Core.Tests\TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EasyBI.Wpf\EasyBI.Wpf.csproj" />
    <ProjectReference Include="..\..\src\EasyBI.Themes.MaterialDesign\EasyBI.Themes.MaterialDesign.csproj" />
    <ProjectReference Include="..\..\src\EasyBI.Themes.WpfUi\EasyBI.Themes.WpfUi.csproj" />
    <ProjectReference Include="..\..\src\EasyBI.Renderers.LiveCharts2\EasyBI.Renderers.LiveCharts2.csproj" />
    <ProjectReference Include="..\..\src\EasyBI.Renderers.OxyPlot\EasyBI.Renderers.OxyPlot.csproj" />
  </ItemGroup>

</Project>
